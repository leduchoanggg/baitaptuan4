@model baitaptuan4.Models.SinhVien

@{
    ViewData["Title"] = "Chỉnh sửa sinh viên";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Cập Nhật Thông Tin Sinh Viên</h2>
    <hr />
    <form asp-action="Edit">
        <input type="hidden" asp-for="MaSv" />
        <div class="mb-3">
            <label class="form-label">Họ và Tên</label>
            <input asp-for="HoTen" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" type="email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ngày Sinh</label>
            <input asp-for="NgaySinh" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Lớp</label>
            <input asp-for="Lop" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>